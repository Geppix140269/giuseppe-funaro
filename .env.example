# Giuseppe OS - Slice 1 environment configuration.
# Set these as Netlify environment variables (Site settings -> Environment
# variables), scoped to Functions. Never commit real values to this file.

# Google OAuth 2.0 Client ID (Web application) used for Sign in with Google.
# Not secret, but kept in config rather than hard-coded into any file.
OS_GOOGLE_CLIENT_ID=

# The single Google account allowed to sign in to Giuseppe OS.
OS_ALLOWED_OWNER_EMAIL=

# Long random secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
OS_SESSION_SECRET=

# Dedicated "Giuseppe OS" Supabase project - must stay separate from the
# existing ClassMA and Ponte Trade projects.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
